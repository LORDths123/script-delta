-- ==========================================================
-- GRAVEL.CC | ULTRA FPS BOOST & CLEANER [AUTO-DESTRUCT]
-- ==========================================================

task.spawn(function()
    local Lighting = game:GetService("Lighting")
    local Workspace = game:GetService("Workspace")
    local StarterGui = game:GetService("StarterGui")

    -- Notificação visual simples no chat ou tela se suportado
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = "Gravel.cc Optimizer",
            Text = "Limpando gráficos e aplicando Boost de FPS...",
            Duration = 3
        })
    end)

    -- Desativar sombras globais e luzes pesadas
    pcall(function()
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 999999
        Lighting.Brightness = 2
        for _, v in ipairs(Lighting:GetChildren()) do
            if v:IsA("PostEffect") or v:IsA("Atmosphere") or v:IsA("Sky") then
                v:Destroy()
            end
        end
    end)

    -- Varredura e limpeza otimizada do Workspace
    local count = 0
    for _, obj in ipairs(Workspace:GetDescendants()) do
        pcall(function()
            if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") or obj:IsA("Explosion") then
                obj:Destroy()
                count = count + 1
            elseif obj:IsA("BasePart") then
                obj.Material = Enum.Material.SmoothPlastic
                obj.Reflectance = 0
                obj.CastShadow = false
            elseif obj:IsA("Decal") or obj:IsA("Texture") then
                obj:Destroy()
            end
        end)
    end

    print("[Gravel Optimizer] Limpeza concluída! Elementos removidos: " .. count)

    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = "Gravel.cc Optimizer",
            Text = "FPS Boost aplicado com sucesso! Script encerrado.",
            Duration = 3
        })
    end)

    -- Autodestruição total do script da memória
    script:Destroy()
end)
